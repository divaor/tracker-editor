<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="file" path="node-data/" />
        <exclude domain="file" path="nodejs/" />
        <exclude domain="file" path="picked/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="file" path="node-data/" />
        <exclude domain="file" path="nodejs/" />
        <exclude domain="file" path="picked/" />
    </device-transfer>
</data-extraction-rules>
