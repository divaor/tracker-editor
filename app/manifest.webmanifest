{
  "name": "Tracker Editor",
  "short_name": "Editor",
  "description": "Many open files, synced through GitHub, with projects, tags and search.",
  "id": "/tracker-editor/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f5f1",
  "theme_color": "#0f766e",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/*",
            "image/*",
            "application/json",
            "application/xml",
            "application/javascript",
            "application/x-yaml",
            "application/x-sh",
            "application/sql",
            "application/octet-stream",
            ".md",
            ".markdown",
            ".txt",
            ".log",
            ".csv",
            ".json",
            ".yaml",
            ".yml",
            ".xml",
            ".sql",
            ".py",
            ".js",
            ".ts",
            ".sh",
            ".ini",
            ".toml",
            ".html",
            ".css"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [
          ".txt",
          ".text",
          ".log",
          ".csv",
          ".tsv",
          ".ini",
          ".cfg",
          ".conf",
          ".env"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "application/json": [
          ".json"
        ],
        "text/yaml": [
          ".yaml",
          ".yml"
        ],
        "text/xml": [
          ".xml"
        ],
        "application/sql": [
          ".sql"
        ],
        "text/x-python": [
          ".py"
        ],
        "text/javascript": [
          ".js",
          ".mjs",
          ".ts"
        ],
        "application/x-sh": [
          ".sh",
          ".ps1",
          ".bat"
        ],
        "application/toml": [
          ".toml"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Voice note",
      "short_name": "Voice note",
      "description": "Dictate a new note",
      "url": "./#/voice",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New note",
      "short_name": "New note",
      "url": "./#/new",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
