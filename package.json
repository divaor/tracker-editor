{
  "name": "tracker-editor",
  "productName": "Tracker Editor",
  "version": "0.4.0",
  "description": "A Notepad++-style editor for many open files, synced through GitHub, with projects, tags, search across files and a local model.",
  "author": "divaor",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/divaor/tracker-editor.git"
  },
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.js",
    "test": "node --test",
    "vendor": "node scripts/vendor.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "htm": "^3.1.1",
    "marked": "^18.1.1"
  },
  "build": {
    "appId": "com.divaor.tracker-editor",
    "productName": "Tracker Editor",
    "files": [
      "electron/**/*",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "Tracker Editor",
        "schemes": [
          "tracker-editor"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
