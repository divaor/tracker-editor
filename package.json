{
  "name": "tracker-editor",
  "productName": "Tracker Editor",
  "version": "0.17.1",
  "description": "A Notepad++-style editor for many open files, synced through GitHub, with projects, tags, search across files and a local model.",
  "author": "divaor",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/divaor/tracker-editor.git"
  },
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.js",
    "test": "node --test",
    "vendor": "node scripts/vendor.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lsp-client": "6.3.0",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "htm": "^3.1.1",
    "marked": "^18.1.1",
    "prettier": "^3.9.9",
    "sql-formatter": "^15.9.0",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "com.divaor.tracker-editor",
    "productName": "Tracker Editor",
    "files": [
      "electron/**/*",
      "app/**/*",
      "package.json",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**",
      "!node_modules/ssh2/lib/protocol/crypto/build/**",
      "!node_modules/ssh2/lib/protocol/crypto/src/**",
      "!node_modules/@lydell/**/*.pdb"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "Tracker Editor",
        "schemes": [
          "tracker-editor"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Tracker Editor types text into another window when you ask it to (Type into another window)."
      },
      "fileAssociations": [
        {
          "ext": [
            "txt",
            "md",
            "markdown",
            "log",
            "json",
            "csv",
            "tsv",
            "xml",
            "yaml",
            "yml",
            "toml",
            "ini",
            "cfg",
            "conf",
            "env",
            "sql",
            "py",
            "js",
            "mjs",
            "cjs",
            "ts",
            "tsx",
            "jsx",
            "css",
            "scss",
            "html",
            "htm",
            "sh",
            "zsh",
            "bash",
            "ps1",
            "go",
            "rs",
            "java",
            "kt",
            "c",
            "h",
            "cpp",
            "hpp",
            "cs",
            "rb",
            "php",
            "lua",
            "swift",
            "vue",
            "svelte",
            "graphql",
            "proto",
            "tf",
            "diff",
            "patch"
          ],
          "name": "Text",
          "role": "Editor",
          "rank": "Alternate"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "mimeTypes": [
        "text/plain",
        "text/markdown",
        "text/x-log",
        "text/csv",
        "text/tab-separated-values",
        "application/json",
        "application/xml",
        "text/xml",
        "application/x-yaml",
        "text/x-toml",
        "text/html",
        "text/css",
        "application/javascript",
        "text/javascript",
        "application/x-shellscript",
        "text/x-python",
        "text/x-sql",
        "text/x-c",
        "text/x-c++",
        "text/x-java",
        "text/x-go",
        "text/x-rust",
        "text/x-diff",
        "text/x-patch"
      ]
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "basic-ftp": "^6.2.3",
    "fflate": "^0.8.3",
    "ssh2": "^1.17.0"
  }
}
